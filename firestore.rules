rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Propiedades: cualquiera con el enlace puede leer SU propiedad (por id),
    // pero solo el asesor con sesión iniciada puede listar, crear, editar o borrar.
    match /propiedades/{propId} {
      allow get: if true;
      allow list, write: if request.auth != null;
    }

    // Mensajes: el propietario puede escribir como "propietario";
    // el asesor (con sesión) puede escribir como "asesor" y moderar.
    match /mensajes/{propId}/items/{msgId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['de', 'texto', 'fecha'])
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() <= 1000
                    && (request.resource.data.de == 'propietario' || request.auth != null);
      allow update, delete: if request.auth != null;
    }
  }
}
